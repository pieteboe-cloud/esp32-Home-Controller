<file path="src/main.cpp">
#include <Arduino.h>
#include <IRremote.hpp> // Primary implementation: ONLY in main.cpp!
#include <RF433.h>
#include <IRController.h>
#include "WebUI.h"
#include "Debug.h"
#include <AutomationManager.h>
#include <SettingsManager.h>
#include "CC2500.h"
#include "ControlLivingColors.h"
#include <LampTypes.h>
#include <HardwareConfig.h> // Include the centralized hardware configuration
#include <SPIFFS.h>

// Forward declarations for the compiler
void handleWebCommand(String cmd);
void testAllLamps();

LampState currentStates[11]; // Current state of all 11 lamps
LampState presets[5][11];    // 5 slots of 11 lamp states

// Pin setup  used sofare 33 26 35 25 2 4 5 18 19 23 27 14
RF433 rf(PIN_RF433_RX, PIN_RF433_TX);          //   RX on GPIO 33, TX on GPIO 26
IRController ir(PIN_IR_RX, PIN_IR_BOTTOM);     // RX on GPIO 35, TX on GPIO 25 (PIN_IR_BOTTOM is the shared TX pin)


// 
CC2500 radio(PIN_CC2500_CS, PIN_CC2500_SCK, PIN_CC2500_MISO, PIN_CC2500_MOSI);
ControlLivingColors control(radio);
WebUI webInterface;
AutomationManager automation(rf, ir); // Automation manager
SettingsManager settingsManager; // Settings manager


// --- Animation State ---
bool rainbowActive = false;
uint8_t rainbowStep = 0;
int currentLampIndex = 0;
unsigned long lastRainbowUpdate = 0;


unsigned long runningLedTimer = 0; // Timestamp for non-blocking running LED control
bool runningLedState = HIGH; // Initial state for running LED (HIGH = off for inverted logic)
unsigned long ledTimer = 0; // Timestamp for non-blocking LED control

void pulseLed(int ms) {
    digitalWrite(PIN_STATUS_LED, LOW);
    ledTimer = millis() + ms;
}

void setup() {
    Debug::init(); // Initialize debugging
    
    radio.begin(); //  Initialize SPI and CC2500 pins and living colors setup
    //radio.setRXMode(); // Ensure radio starts in listening mode

    // Initialize file system and settings
    settingsManager.init();
    settingsManager.loadPresets((uint8_t*)presets, sizeof(presets)); // Load saved lamp data immediately after filesystem init
   
       
    webInterface.init("Home-Controller-AP", [](String n){ pulseLed(100); });
    webInterface.setControllers(&control, &automation, &settingsManager, 
                                currentStates, (LampState*)presets, 
                                &rainbowActive, &currentLampIndex);

    

    // Link hardware state to WebUI (Inverted logic: LOW = ON)
    webInterface.setStatusProvider([]() {
        return runningLedState == LOW;
    });
    
    // Set reboot callback
    webInterface.setRebootCallback([]() {
        settingsManager.reboot();
    });
    
    // Set settings callback
    webInterface.setSettingsCallback([]() -> String {
        String json = settingsManager.loadSettings();
        
        // Inject lamp data into the settings view
        String lampJson = ",\"lamp_data\":{";
        for(int i=0; i<5; i++) {
            int configured = 0;
            for(int j=0; j<11; j++) if(presets[i][j].v > 0) configured++;
            lampJson += "\"Preset_" + String(i) + "\":\"" + String(configured) + " lamps configured\"";
            if(i < 4) lampJson += ",";
        }
        lampJson += "}";

        // If the settings manager returns a JSON object, merge the strings
        if (json.endsWith("}")) {
            return json.substring(0, json.length() - 1) + lampJson + "}";
        }
        return json;
    });

    pinMode(PIN_STATUS_LED, OUTPUT);
    pinMode(PIN_RUNNING_LED, OUTPUT); 
    digitalWrite(PIN_RUNNING_LED, runningLedState); 
    digitalWrite(PIN_STATUS_LED, HIGH);
    rf.init();
    ir.init();
    
    // Link automation to hardware and load scenes
    automation.setLampController(&control, SettingsManager::lampAddr);
    automation.initDefaultScenes();

    // Initialize the library's IR Sender for the zoned strips
    IrSender.begin(PIN_IR_BOTTOM);

    // Initialize current states to "Off"
    for(int i=0; i<11; i++) {
        currentStates[i] = {0, 0, 255}; // Default brightness to 255 to match WebUI
    }

    Debug::println("[INFO][MAIN] System Online: RF433, IR, and 11-Lamp Controller ready.");
    
    // Configure CC2500 for LivingColors
   
    Debug::setVerbose( false); // Enable verbose logging for testing

   
}

void loop() {

        webInterface.handle();

        
    // Handle non-blocking LED turn-off
    if (ledTimer != 0 && (long)(millis() - ledTimer) >= 0) {
        digitalWrite(PIN_STATUS_LED, HIGH);
        ledTimer = 0;
    }

    // Handle non-blocking running LED toggle
    if (millis() - runningLedTimer >= 500) { // Toggle every 500ms
        runningLedState = !runningLedState; // Invert the state
        digitalWrite(PIN_RUNNING_LED, runningLedState); 
        runningLedTimer = millis(); // Reset the timer
    }

    // Handle animated rainbow effect
    // To maintain WebUI responsiveness and RF/IR sensing, we update only one lamp
    // per cycle. This prevents the CC2500's blocking TX loop from starving other tasks.
    if (rainbowActive && millis() - lastRainbowUpdate >= 30) {
        lastRainbowUpdate = millis();

        uint8_t hue = (uint8_t)((currentLampIndex * 255 / 11) + rainbowStep);
        uint8_t brightness = currentStates[currentLampIndex].v; // Respect current dimmer level
        control.setColor(settingsManager.lampAddr[currentLampIndex], settingsManager.lampAddr[currentLampIndex], hue, 255, brightness);
        currentStates[currentLampIndex] = {hue, 255, brightness};

        currentLampIndex++;
        if (currentLampIndex >= 11) {
            currentLampIndex = 0;
            rainbowStep += 2; // Controls the rotation speed of the color wheel
        }
    }

    unsigned long received = rf.receive();
    if (received != 0) {
        pulseLed(100);
        Debug::print("[INFO][MAIN] RF Received: ");
        Debug::print(received);
        Debug::print(" / ");
        Debug::print(rf.getReceivedBitlength());
        Debug::print("bit / Protocol: ");
        Debug::println(rf.getReceivedProtocol());
        
        // Check if this RF code triggers any automation
        automation.checkTrigger(received, rf.getReceivedBitlength(), rf.getReceivedProtocol());
    }

    unsigned long receivedIR = ir.receive();
    if (receivedIR != 0) {
        pulseLed(100);
        Debug::print("[INFO][MAIN] IR Received: 0x");
        Debug::print(String(receivedIR, HEX));
        Debug::print(" / ");
        Debug::print(ir.getReceivedBitlength());
        Debug::print("bit / Protocol: ");
        Debug::println(ir.getReceivedProtocol());
    }

   
}

void testAllLamps() {
    Debug::println("[TEST] Starting lamp test sequence...");

    // Test each lamp with a different color (non-blocking - commands queued)
    for (int i = 0; i < 11; i++) {
        // Calculate a different hue for each lamp (spread across the color wheel)
        uint8_t hue = (i * 255) / 11;

        // Set the lamp color (HSV: hue, saturation=255, value=255)
        control.setColor(settingsManager.lampAddr[i], settingsManager.lampAddr[i], hue, 255, 255);

        Debug::println("[TEST] Lamp " + String(i + 1) + " set to hue: " + String(hue));
    }

    Debug::println("[TEST] All lamps tested!");
}
